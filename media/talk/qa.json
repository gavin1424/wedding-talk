{"groom": [{"id": "hello", "caps": [{"s": 0.1, "e": 2.99, "t": "嗨，我是柏宇，很高興你來。"}, {"s": 3.88, "e": 8.6, "t": "婚禮的時間、地點，或是我跟語彤的故事，都可以問我。"}]}, {"id": "when", "chip": "婚禮什麼時候？", "keys": ["什麼時候", "幾點", "時間", "哪一天", "幾號", "日期", "開席", "入席"], "caps": [{"s": 0.1, "e": 6.87, "t": "我們的婚禮在2027 年 3 月 20 日，星期六，上午十一點半入席，十二點開席。"}, {"s": 7.84, "e": 9.19, "t": "那天一定要來喔。"}]}, {"id": "where", "chip": "在哪裡舉辦？", "keys": ["哪裡", "地點", "地址", "會館", "飯店", "餐廳在", "怎麼去"], "caps": [{"s": 0.1, "e": 6.15, "t": "地點在晨光花園婚宴會館，二樓 芙蓉廳，地址是台北市示範區幸福路 100 號。"}, {"s": 7.03, "e": 9.8, "t": "喜帖網站上可以直接開地圖導航。"}]}, {"id": "park", "chip": "怎麼停車？", "keys": ["停車", "開車", "捷運", "交通", "坐車", "搭車"], "caps": [{"s": 0.1, "e": 4.34, "t": "會館地下一樓有停車場，當天憑喜帖可以免費停車。"}, {"s": 5.25, "e": 9.91, "t": "不開車的話，搭捷運到幸福站，二號出口走路大約五分鐘。"}]}, {"id": "met", "chip": "你們怎麼認識的？", "keys": ["認識", "第一次見面", "怎麼在一起", "相遇", "遇到"], "caps": [{"s": 0.1, "e": 2.57, "t": "我們是在朋友的生日聚會認識的。"}, {"s": 3.53, "e": 7.88, "t": "她的髮夾掉了，我幫她撿起來，結果緊張到忘記還給她。"}]}, {"id": "first", "chip": "對新娘的第一印象？", "keys": ["第一印象", "第一眼", "印象"], "caps": [{"s": 0.1, "e": 4.18, "t": "第一眼就覺得，這個女生笑起來，整個房間都亮了。"}, {"s": 5.06, "e": 8.41, "t": "後來才發現，她生氣的時候也一樣亮。"}]}, {"id": "propose", "chip": "怎麼求婚的？", "keys": ["求婚", "跪", "戒指"], "caps": [{"s": 0.1, "e": 2.86, "t": "我在我們第一次見面的那間餐廳求婚。"}, {"s": 3.75, "e": 9.4, "t": "練了一個月的台詞，跪下去的時候全忘了，只說了一句，嫁給我好不好。"}]}, {"id": "like", "chip": "最喜歡她什麼？", "keys": ["喜歡她", "愛她", "優點", "為什麼選", "為什麼娶"], "caps": [{"s": 0.1, "e": 4.14, "t": "最喜歡她不管多累，回到家還是會問我今天好不好。"}, {"s": 5.02, "e": 7.02, "t": "有她在，家才像家。"}]}, {"id": "promise", "chip": "婚後有什麼承諾？", "keys": ["承諾", "保證", "答應", "婚後", "以後", "誓言"], "caps": [{"s": 0.1, "e": 5.71, "t": "我答應她，每天都說一次謝謝，吵架不過夜，還有，碗我來洗。"}]}, {"id": "thanks", "chip": "想對賓客說什麼？", "keys": ["賓客", "想說", "對大家", "感謝", "謝謝"], "bow": true, "caps": [{"s": 0.1, "e": 3.64, "t": "謝謝你們一路看著我們長大、陪我們走到今天。"}, {"s": 4.53, "e": 7.63, "t": "你願意來，對我們就是最好的祝福。"}]}, {"id": "bye", "chip": "恭喜你們！", "keys": ["恭喜", "祝福", "百年好合", "早生貴子", "再見", "掰掰"], "bow": true, "caps": [{"s": 0.1, "e": 1.56, "t": "謝謝你的祝福！"}, {"s": 2.45, "e": 5.83, "t": "那天見，記得空著肚子來，菜很好吃。"}]}, {"id": "fb1", "fallback": true, "caps": [{"s": 0.1, "e": 1.62, "t": "這題有點難倒我了。"}, {"s": 2.51, "e": 6.4, "t": "你可以問我婚禮的時間地點，或是我們的戀愛故事。"}]}, {"id": "fb2", "fallback": true, "caps": [{"s": 0.1, "e": 2.56, "t": "這個我可能要回家問語彤才知道。"}, {"s": 3.45, "e": 5.91, "t": "你也可以點旁邊，直接問她。"}]}], "bride": [{"id": "hello", "caps": [{"s": 0.1, "e": 3.36, "t": "哈囉，我是語彤，謝謝你來看我們。"}, {"s": 4.27, "e": 9.23, "t": "想聊穿搭、餐點，還是想聽他的糗事，都可以問我。"}]}, {"id": "dress", "chip": "要穿什麼去？", "keys": ["穿什麼", "服裝", "衣服", "穿搭", "dress", "正式", "顏色"], "caps": [{"s": 0.1, "e": 5.3, "t": "輕鬆正式就好，想搭配我們的主題，可以穿淡色系的衣服。"}, {"s": 6.26, "e": 8.93, "t": "不用太拘束，你舒服最重要。"}]}, {"id": "food", "chip": "有素食或兒童餐嗎？", "keys": ["素食", "吃素", "兒童", "小孩", "過敏", "餐點", "菜色", "吃什麼"], "caps": [{"s": 0.1, "e": 3.34, "t": "有的，素食跟兒童座椅都可以安排。"}, {"s": 4.34, "e": 8.29, "t": "回覆出席的時候備註一下，我們會幫你準備好。"}]}, {"id": "rsvp", "chip": "要怎麼回覆出席？", "keys": ["回覆", "出席", "報名", "不能來", "參加", "人數", "rsvp"], "caps": [{"s": 0.1, "e": 8.76, "t": "在喜帖網站下面填一下出席人數就可以了，麻煩在2027 年 2 月 20 日以前告訴我們，謝謝你。"}]}, {"id": "met", "chip": "妳眼中的相遇？", "keys": ["認識", "第一次見面", "怎麼在一起", "相遇", "遇到"], "caps": [{"s": 0.1, "e": 4.61, "t": "他到現在都以為我不知道，那支髮夾是他故意不還的。"}, {"s": 5.57, "e": 7.93, "t": "其實我也是故意沒有要回來。"}]}, {"id": "first", "chip": "對新郎的第一印象？", "keys": ["第一印象", "第一眼", "印象"], "caps": [{"s": 0.1, "e": 2.91, "t": "覺得他好有禮貌，然後有點呆。"}, {"s": 3.88, "e": 7.79, "t": "結婚以前我以為那是裝的，後來發現是真的。"}]}, {"id": "propose", "chip": "被求婚時的心情？", "keys": ["求婚", "跪", "戒指", "感動"], "caps": [{"s": 0.1, "e": 3.87, "t": "他跪下去就忘詞了，整間餐廳都在等他。"}, {"s": 4.75, "e": 8.4, "t": "我一邊笑一邊哭，還沒等他說完就點頭了。"}]}, {"id": "like", "chip": "最喜歡他什麼？", "keys": ["喜歡他", "愛他", "優點", "為什麼選", "為什麼嫁"], "caps": [{"s": 0.1, "e": 3.37, "t": "他很笨拙，可是答應我的事都會做到。"}, {"s": 4.3, "e": 6.35, "t": "跟他在一起，我很安心。"}]}, {"id": "gown", "chip": "婚紗是自己挑的嗎？", "keys": ["婚紗", "禮服", "頭紗", "挑的"], "caps": [{"s": 0.1, "e": 4.58, "t": "對呀，試了十幾件，最後選了這件有蕾絲花朵的。"}, {"s": 5.53, "e": 8.16, "t": "他看到的時候，眼眶都紅了。"}]}, {"id": "honey", "chip": "蜜月要去哪裡？", "keys": ["蜜月", "旅行", "度假", "出國"], "caps": [{"s": 0.1, "e": 1.04, "t": "還在吵耶。"}, {"s": 2.01, "e": 6.28, "t": "他想去看極光，我想去海邊，應該會先去海邊。"}]}, {"id": "thanks", "chip": "想對賓客說什麼？", "keys": ["賓客", "想說", "對大家", "感謝", "謝謝"], "bow": true, "caps": [{"s": 0.1, "e": 2.63, "t": "謝謝你願意把這一天留給我們。"}, {"s": 3.57, "e": 7.15, "t": "能在最幸福的時候看見你，我真的很開心。"}]}, {"id": "bye", "chip": "新娘好美！", "keys": ["好美", "漂亮", "恭喜", "祝福", "百年好合", "再見", "掰掰"], "bow": true, "caps": [{"s": 0.1, "e": 2.43, "t": "謝謝你，你太會說話了！"}, {"s": 3.35, "e": 6.09, "t": "婚禮那天見，我們一起拍照喔。"}]}, {"id": "fb1", "fallback": true, "caps": [{"s": 0.1, "e": 1.74, "t": "這題我要想一下耶。"}, {"s": 2.7, "e": 6.37, "t": "你可以問我穿搭、餐點，或是他的糗事。"}]}, {"id": "fb2", "fallback": true, "caps": [{"s": 0.1, "e": 2.21, "t": "這個可能要問柏宇才知道。"}, {"s": 3.14, "e": 5.44, "t": "你點旁邊，換他回答你。"}]}]}